{
  "name": "@ainsel/plugin-sdk",
  "version": "1.1.0",
  "type": "module",
  "description": "AInsel plugin SDK for building console extensions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainsel-project/ainsel.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/ainsel-project/ainsel/blob/main/docs/writing-a-plugin.md",
  "keywords": [
    "ainsel",
    "plugin",
    "sdk",
    "console"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
