{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],

		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noFallthroughCasesInSwitch": true,

		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true
	},
	"include": ["index.ts", "src/**/*.ts"],
	"exclude": ["node_modules", "src/**/*.test.ts"]
}
