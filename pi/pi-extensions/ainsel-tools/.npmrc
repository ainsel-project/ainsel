# The Dockerfile runs `npm install --omit=dev` in this directory. Without
# legacy-peer-deps, npm would auto-install this extension's
# `@earendil-works/pi-coding-agent` peer into node_modules — a second,
# version-floating copy of the very package that already runs in this
# container.
#
# At runtime no local copy is needed: pi's extension loader (jiti) aliases
# `@earendil-works/pi-coding-agent` to its own entry point, and this extension
# imports from it as a type only. The peerDependencies entry is for IDEs and
# the typecheck.
legacy-peer-deps=true
