# Build the manager binary
FROM golang:1.27-bookworm AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# Build context = monorepo root. Copy only the modules we need and
# initialize a focused go.work so Go resolves shared/api locally.
# shared/testutil is test-only but is a `replace`d requirement of the
# operator module, so its go.mod must exist for the module graph to load.
COPY shared/api ./shared/api
COPY shared/testutil ./shared/testutil
COPY operators/event-gateway ./operators/event-gateway
RUN go work init ./shared/api ./operators/event-gateway

WORKDIR /workspace/operators/event-gateway

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o /manager ./cmd

# Runtime
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /
COPY --from=builder /manager .
# Third-party license notices (Apache-2.0 §4(d)); see NOTICE.
# Generated by scripts/generate-third-party-licenses.py.
COPY NOTICE THIRD_PARTY_LICENSES.md /legal/
COPY LICENSES /legal/LICENSES
USER nonroot:nonroot
ENTRYPOINT ["/manager"]
